# ── Telegram ─────────────────────────────────────────────────────────────────
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
BOT_USERNAME=mysharebot           # without the @

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_ID=123456789               # your Telegram numeric user ID

# ── Redis (Upstash recommended — free tier works perfectly) ───────────────────
REDIS_URL=rediss://default:password@your-upstash-endpoint.upstash.io:6380

# ── Deployment ────────────────────────────────────────────────────────────────
BASE_URL=https://your-project.vercel.app
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=replace_with_a_strong_random_string

# ── Optional: auto-publish channel ───────────────────────────────────────────
# Leave as 0 to disable. Use negative IDs for supergroups/channels.
DEFAULT_CHANNEL_ID=0
